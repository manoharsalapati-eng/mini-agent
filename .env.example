# Copy to .env and fill in ONE provider. .env is git-ignored; never commit real keys.
# mini-agent reads this file at start-up (already-set environment variables win).

# --- Anthropic (default provider) ---
ANTHROPIC_API_KEY=
# AGENT_MODEL=claude-opus-5-5
# AGENT_EFFORT=medium        # low | medium | high | xhigh | max

# --- Any OpenAI-compatible API (use with --provider openai) ---
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# AGENT_MODEL=llama-3.3-70b-versatile
